# ==============================================================================
# Cloud Backend Ops Configuration Template
# Copy this file to .env for local testing: cp .env.example .env
# In GitHub Actions, configure these in Repository Settings -> Secrets and variables -> Actions
# ==============================================================================

# Application Environment
APP_ENV=staging
APP_NAME=CloudOps-DB-Monitor
DRY_RUN=false

# ==============================================================================
# Cloud MySQL Database Credentials
# Compatible with AWS RDS, GCP Cloud SQL, PlanetScale, Aiven, Azure MySQL, etc.
# ==============================================================================
DB_HOST=your-mysql-host.cloudprovider.com
DB_PORT=3306
DB_USER=your_db_username
DB_PASSWORD=your_db_password
DB_NAME=ops_monitoring
DB_CONNECT_TIMEOUT=10
DB_USE_SSL=true

# ==============================================================================
# SMTP Email Service Configuration
# Compatible with Gmail, Outlook/Office365, SendGrid, Amazon SES, Mailgun, etc.
# ==============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_specific_password
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Email Routing
EMAIL_FROM=DevOps Pipeline <your_email@gmail.com>
EMAIL_TO=alerts@yourcompany.com
